# Main-process variables must be set in the parent process environment.
# backend-service imports run before index.js calls dotenv; this file alone does not set them.
# Paths below are relative examples, not real machine paths.
TCM_BACKEND_EXE=./external/tcm_app/tcm_app.exe
TCM_RUOYI_JAR=./external/ruoyi-admin.jar
TCM_IMAGE_BASE_PATH=./external/tcm_app
