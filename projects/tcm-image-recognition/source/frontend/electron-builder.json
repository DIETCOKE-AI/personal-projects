{
  "productName": "ZhenshiTech",
  "appId": "com.zhenshitech.app",
  "asar": true,
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/",
    "node_modules/",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "python-dist",
      "to": "python-dist",
      "filter": [
        "**/*"
      ]
    }
  ],
  "win": {
    "target": "nsis"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
